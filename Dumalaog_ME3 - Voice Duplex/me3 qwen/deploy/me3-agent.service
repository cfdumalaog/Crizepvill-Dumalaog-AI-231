[Unit]
Description=ME3 Voice Duplex - full-duplex voice agent and LAN browser UI
After=network.target me3-asr.service me3-tts.service me3-vad.service
Wants=me3-asr.service me3-tts.service me3-vad.service

[Service]
WorkingDirectory=__ME3_DIR__
ExecStart=__VENV__/bin/python __ME3_DIR__/scripts/me3_pi_server.py --host 0.0.0.0 --port 8126 --audio-port 8127 --brain remote --variant qwen_instruct --output browser
Restart=on-failure
RestartSec=3
Environment=ME3_CONFIG=__ME3_DIR__/config/config.yaml
EnvironmentFile=-%h/.config/me3/me3.env
EnvironmentFile=-%h/.config/me3/qwen-instruct.env
Environment=PYTHONUNBUFFERED=1
# Audio device priority (USB/I2S) - tune for your Pi
Nice=-5

[Install]
WantedBy=default.target
